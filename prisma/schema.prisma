generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyType {
  MAIN
  BRANCH
}

enum VisitType {
  DEMO
  INFO_GATHERING
  INSTALLATION
  INDUCTION
  REINDUCTION
  POST_SALE
  TECHNICAL
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum PaymentPeriod {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  OTHER
}

enum ClientProductStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
  PENDING
}

enum LicenseType {
  PERPETUAL
  SUBSCRIPTION
  TRIAL
  OEM
  VOLUME
  NAMED_USER
  CONCURRENT
}

enum RenewalPeriod {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum SupportPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ReportType {
  ERP_INSTALLATION
  TELECOM_NETWORK
  SECURITY_CAMERAS
}

enum ImplSheetStatus {
  DRAFT
  COMPLETED
  APPROVED
  REJECTED
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  roleId        Int?
  role          Role?    @relation(fields: [roleId], references: [id])
  isActive      Boolean  @default(true)
  hasCommissions Boolean @default(false)
  docType       String?
  docNumber     String?
  position      String?
  state         String?
  fullAddress   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts         Account[]
  sessions         Session[]
  assignedVisits   Visit[]              @relation("AssignedUser")
  assignedCases    SupportCase[]        @relation("AssignedSupportUser")
  transfers        Transfer[]           @relation("TransferUser")
  approvedTransfers Transfer[]          @relation("ApprovedTransfer")
  comments         SupportCaseComment[]
  salesRepCompanies Company[]           @relation("CompanySalesRep")
  alerts           Alert[]
  createdReports   TechnicalReport[]    @relation("ReportCreator")
  createdSheets    ImplementationSheet[]

  @@map("users")
}

model Role {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String?
  permissions Json?

  users User[]

  @@map("roles")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Company {
  id          Int       @id @default(autoincrement())
  name        String
  taxIdType   String?   @default("V")
  taxId       String?
  address     String?
  state       String?
  municipality String?
  parish      String?
  localidad   String?
  phone       String?
  email       String?
  website     String?
  type        CompanyType @default(MAIN)
  parentId    Int?
  parent      Company?    @relation("CompanyHierarchy", fields: [parentId], references: [id])
  branches    Company[]   @relation("CompanyHierarchy")
  notes       String?
  isActive    Boolean     @default(true)
  salesRepId  Int?
  salesRep    User?       @relation("CompanySalesRep", fields: [salesRepId], references: [id])
  economicActivity String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contacts         Contact[]
  clientProducts   ClientProduct[]
  licenseCompanies LicenseAssignment[] @relation("LicenseCompany")
  licenseBranches  LicenseAssignment[] @relation("LicenseBranch")
  visits           Visit[]
  supportCases     SupportCase[]
  technicalReports TechnicalReport[]
  implSheets       ImplementationSheet[]

  @@map("companies")
}

model Contact {
  id        Int     @id @default(autoincrement())
  companyId Int
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits       Visit[]
  supportCases SupportCase[]

  @@map("contacts")
}

model ProductCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@map("product_categories")
}

model Product {
  id              Int           @id @default(autoincrement())
  name            String
  description     String?
  categoryId      Int?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  type            ProductType   @default(PRODUCT)
  cost            Decimal       @db.Decimal(10, 2) @default(0)
  price           Decimal       @db.Decimal(10, 2)
  discountPercent Float         @default(0)
  ivaPercent      Float         @default(0)
  paymentPeriod   PaymentPeriod @default(ONE_TIME)
  dailyPrice      Float         @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  clientProducts ClientProduct[]
  licenses       License[]

  @@map("products")
}

model ClientProduct {
  id        Int                @id @default(autoincrement())
  companyId Int
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId Int
  product   Product            @relation(fields: [productId], references: [id])
  quantity  Int                @default(1)
  price     Decimal            @db.Decimal(10, 2)
  startDate DateTime?
  endDate   DateTime?
  status    ClientProductStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("client_products")
}

model License {
  id          Int         @id @default(autoincrement())
  licenseKey  String      @unique
  productId   Int
  product     Product     @relation(fields: [productId], references: [id])
  startDate   DateTime
  endDate     DateTime
  maxUsers    Int         @default(1)
  status      LicenseStatus @default(ACTIVE)

  licenseId                String?   @unique
  name                     String?
  costUSD                  Decimal?  @db.Decimal(12, 2)
  supportHours             Int?      @default(0)
  freeDays                 Int?      @default(0)
  discountPercent          Decimal?  @db.Decimal(5, 2)
  allowedTechnicalVisits   Int?      @default(0)
  additionalTechHourValue  Decimal?  @db.Decimal(10, 2)
  additionalTrainingPerPerson Decimal? @db.Decimal(10, 2)

  licenseType              LicenseType? @default(SUBSCRIPTION)
  version                  String?
  edition                  String?
  maxActivations           Int?      @default(1)
  usedActivations          Int?      @default(0)
  autoRenew                Boolean   @default(false)
  renewalDate              DateTime?
  renewalPeriod            RenewalPeriod?
  lastActivatedAt          DateTime?
  lastUsedAt               DateTime?
  purchaseDate             DateTime?
  vendor                   String?
  purchaseOrderNumber      String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  assignments LicenseAssignment[]

  @@map("licenses")
}

model LicenseAssignment {
  id            Int         @id @default(autoincrement())
  licenseId     Int
  license       License     @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  companyId     Int
  company       Company     @relation("LicenseCompany", fields: [companyId], references: [id], onDelete: Cascade)
  branchId      Int?
  branch        Company?    @relation("LicenseBranch", fields: [branchId], references: [id])
  status        LicenseStatus @default(ACTIVE)
  renewalPeriod RenewalPeriod?
  assignedAt    DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([licenseId, companyId, branchId])
  @@map("license_assignments")
}

model Visit {
  id            Int         @id @default(autoincrement())
  companyId     Int
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId     Int?
  contact       Contact?    @relation(fields: [contactId], references: [id])
  type          VisitType
  scheduledDate DateTime
  completedDate DateTime?
  status        VisitStatus @default(SCHEDULED)
  assignedTo    Int?
  assignedUser  User?       @relation("AssignedUser", fields: [assignedTo], references: [id])
  notes         String?
  reportUrl     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  technicalReports TechnicalReport[]

  @@map("visits")
}

model SupportCase {
  id           Int            @id @default(autoincrement())
  companyId    Int
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId    Int?
  contact      Contact?       @relation(fields: [contactId], references: [id])
  subject      String
  description  String         @db.Text
  priority     SupportPriority @default(MEDIUM)
  status       SupportStatus  @default(OPEN)
  slaDeadline  DateTime?
  assignedTo   Int?
  assignedUser User?          @relation("AssignedSupportUser", fields: [assignedTo], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  comments SupportCaseComment[]

  @@map("support_cases")
}

model SupportCaseComment {
  id        Int         @id @default(autoincrement())
  caseId    Int
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  comment   String      @db.Text
  createdAt DateTime    @default(now())

  @@map("support_case_comments")
}

model Transfer {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation("TransferUser", fields: [userId], references: [id])
  fromLocation String
  toLocation   String
  transferDate DateTime
  reason       String       @db.Text
  approvedById Int?
  approvedBy   User?        @relation("ApprovedTransfer", fields: [approvedById], references: [id])
  status       TransferStatus @default(PENDING)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("transfers")
}

model Alert {
  id                Int      @id @default(autoincrement())
  type              String
  title             String
  message           String   @db.Text
  relatedEntityType String?
  relatedEntityId   Int?
  isRead            Boolean  @default(false)
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@map("alerts")
}

model TechnicalReport {
  id            Int        @id @default(autoincrement())
  visitId       Int?
  visit         Visit?     @relation(fields: [visitId], references: [id])
  companyId     Int
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reportType    ReportType
  title         String
  content       String     @db.Text
  findings      String?    @db.Text
  recommendations String?  @db.Text
  createdBy     Int
  creator       User       @relation("ReportCreator", fields: [createdBy], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("technical_reports")
}

model ImplementationSheet {
  id            Int           @id @default(autoincrement())
  companyId     Int
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialData Json
  products      Json
  contractTerms Json?
  notes         String?
  status        ImplSheetStatus @default(DRAFT)
  createdBy     Int
  creator       User          @relation(fields: [createdBy], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("implementation_sheets")
}
